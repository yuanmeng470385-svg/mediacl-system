# MedAgent 生产 .env 差异样板（对照根 .env.example，其余键同开发模板）
# 从 .env.example 复制后按本文件覆盖以下键；DB/Redis 密码务必重新生成强随机值。

# --- 安全开关（docker-compose.prod.yml 对 auth-service 也硬覆盖了 AUTH_DEV_MODE=false）---
AUTH_DEV_MODE=false     # production 下若为 true，auth-service 启动守卫直接拒绝启动
DEPLOY_ENV=production   # 生产守卫标记

# --- 分享落地页 ---
# 数字分身分享链接前缀：设了走 web 落地页（{base}/share/twin/<token>），不设退回 App 深链
SHARE_WEB_URL_BASE=http://<服务器IP或域名>   # 上 nginx 后即 80/443，不带尾斜杠

# --- 必改强随机值 ---
JWT_SECRET=<openssl rand -hex 32>
DB_PASSWORD=<强随机>
REDIS_PASSWORD=<强随机>
AUDIT_DB_PASSWORD=<强随机>   # 与首次执行 scripts/migrations/002_audit_immutable.sql 时一致
