# ============================================
# MedAgent 数字员工系统 - 环境变量配置
# 复制此文件为 .env 并填入实际值
# ============================================

# --- 阿里云账号（团队共享）---
ALIYUN_ACCESS_KEY_ID=your_access_key_id
ALIYUN_ACCESS_KEY_SECRET=your_access_key_secret
ALIYUN_REGION=cn-hangzhou

# --- 百炼 SDK（与 ALIYUN_* 同值）---
ALIBABA_CLOUD_ACCESS_KEY_ID=your_access_key_id
ALIBABA_CLOUD_ACCESS_KEY_SECRET=your_access_key_secret

# --- 通义千问 API（通过百炼平台调用）---
DASHSCOPE_API_KEY=your_dashscope_api_key
QWEN_MAX_MODEL=qwen-max
QWEN_PLUS_MODEL=qwen-plus
QWEN_TURBO_MODEL=qwen-turbo
QWEN_VL_MODEL=qwen-vl-max

# --- 通义听悟（语音转写）---
TINGWU_APP_KEY=your_tingwu_app_key
TINGWU_ACCESS_TOKEN=your_tingwu_access_token

# --- 阿里云百炼（多模态交互 WebSocket）---
BAILIAN_API_KEY=your_bailian_api_key
BAILIAN_WS_URL=wss://dashscope.aliyuncs.com/api-ws/v1/inference
BAILIAN_WORKSPACE_ID=your_workspace_id
BAILIAN_KB_ID=your_bailian_knowledge_base_id
BAILIAN_INDEX_ID=your_bailian_index_id
BAILIAN_APP_ID=your_bailian_app_id
BAILIAN_API_BASE=https://bailian.aliyuncs.com/v2

# --- 阿里云 DashVector（向量检索）---
DASHVECTOR_API_KEY=your_dashvector_api_key
DASHVECTOR_ENDPOINT=your_dashvector_endpoint

# --- 阿里云 OSS（对象存储）---
OSS_ACCESS_KEY_ID=your_oss_access_key_id
OSS_ACCESS_KEY_SECRET=your_oss_access_key_secret
OSS_BUCKET=medagent-files
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com

# --- 数据库备份（scripts/backup_db.py + scripts/restore_db.py）---
BACKUP_DIR=./backups                # 本地保留目录
BACKUP_RETENTION_LOCAL_DAYS=7       # 本地保留天数
BACKUP_RETENTION_OSS_DAYS=30        # OSS 保留天数
BACKUP_OSS_PREFIX=backups/          # OSS 对象前缀
BACKUP_PG_CONTAINER=medagent-postgres

# --- 数据库（本地开发用 Docker）---
DATABASE_URL=postgresql://medagent:medagent123@localhost:5432/medagent
REDIS_URL=redis://localhost:6379/0
# 审计服务专用连接串（宿主机直跑 uvicorn 时用本值；容器内由 compose 覆盖为
# medagent_audit@postgres，本值可留占位）。
# 账号 medagent_audit 由 scripts/migrations/002_audit_immutable.sql 创建（密码即 AUDIT_DB_PASSWORD），
# 仅 INSERT/SELECT audit_logs。002 未执行前该角色不存在，audit-service 无法连接 ——
# 首次部署必须手动执行 002（见 scripts/migrations/002_audit_immutable.sql 头部用法说明）。
AUDIT_DATABASE_URL=postgresql://medagent_audit:change_me_to_a_random_secret_string@localhost:5432/medagent

# --- 生产部署（deploy/docker-compose.prod.yml 使用）---
# DB_USER 必须与 scripts/init_db.sql:173 的 REVOKE 角色名一致（默认 medagent）：
# 改名需同步修改 init_db.sql 与 002_audit_immutable.sql，否则 init 脚本报错/权限收紧失效。
DB_USER=medagent
DB_PASSWORD=change_me_to_a_random_secret_string
# 镜像仓库与标签（deploy.yml 推送、prod compose 拉取时使用）
DOCKER_REGISTRY=registry.cn-hangzhou.aliyuncs.com
IMAGE_TAG=latest

# --- JWT 认证 ---
# auth-service 会拒绝以默认值启动，请生成随机值：openssl rand -hex 32
JWT_SECRET=change_me_to_a_random_secret_string
# 服务间内部调用鉴权（网关白名单接口必须带 X-Internal-Key）。未配置或默认值 → 服务拒绝启动
# 生成：openssl rand -hex 32
INTERNAL_API_KEY=change_me_to_a_random_secret_string
# 审计专用 DB 账号密码（002_audit_immutable.sql 创建 medagent_audit 时使用；与 DB 密码分开轮换）。
# 必填：compose 用 ${AUDIT_DB_PASSWORD:?} 强制校验，未设置时 audit-service 拒绝启动。
# 002 迁移执行时 -v audit_password 必须与本值一致，否则 audit-service 连不上库。
AUDIT_DB_PASSWORD=change_me_to_a_random_secret_string
# Redis 密码（生产必须设置：deploy/docker-compose.prod.yml 的 redis 用 --requirepass 启动，
# 生产 .env 的 REDIS_URL 需改成 redis://:<REDIS_PASSWORD>@redis:6379/0）
REDIS_PASSWORD=change_me_to_a_random_secret_string
# 实时转写（NLS 管控台项目 Appkey；未配置时 visit-service 实时转写 fail-closed 报错，不产生假文本；
# 开发联调可设 NLS_MOCK=1 启用 Mock 模拟文本——Mock 文本不落库，配真 AppKey 后应删除）
NLS_APPKEY=change_me_to_nls_appkey
NLS_MOCK=0
JWT_EXPIRES_IN=7d

# --- 认证服务（可选，均有安全默认值）---
AUTH_SMS_PROVIDER=console          # console=验证码只写日志 / aliyun=需签名和模板CODE
AUTH_SMS_SIGN_NAME=                # 阿里云短信签名（如"某某医药"），配齐后 AUTH_SMS_PROVIDER=aliyun 生效
AUTH_SMS_TEMPLATE_CODE=            # 阿里云短信模板 CODE（如 SMS_123456789），变量名用 code
AUTH_DEV_MODE=false                # true 时 send-code 会在响应里回传验证码，仅本地联调用
AUTH_CODE_TTL_SECONDS=300          # 验证码有效期
AUTH_CODE_RESEND_SECONDS=60        # 重发冷却
AUTH_CODE_MAX_ATTEMPTS=5           # 单个验证码最多校验次数

# --- 服务端口 ---
AUTH_SERVICE_PORT=8007
SPECIALIST_SERVICE_PORT=8001
VISIT_SERVICE_PORT=8002
KNOWLEDGE_SERVICE_PORT=8003
COMPLIANCE_SERVICE_PORT=8004
AUDIT_SERVICE_PORT=8005
HCP_SERVICE_PORT=8006
GATEWAY_PORT=8000

# --- 阿里云 ARMS 监控（可选）---
ARMS_ENDPOINT=your_arms_endpoint
ARMS_APP_NAME=medagent

# --- 日志 ---
LOG_LEVEL=INFO
# 审计日志保留天数（audit-service 清理任务消费：启动即跑 + 每 CLEANUP_INTERVAL_HOURS 小时一次）
AUDIT_LOG_RETENTION_DAYS=1095
# 清理周期（小时）
AUDIT_LOG_CLEANUP_INTERVAL_HOURS=24
# 清理专用连接：medagent_audit_cleanup（migrations/005_audit_cleanup.sql 创建的
# 删除专用账号，仅 SELECT+DELETE；应用账号 medagent_audit 仍无 DELETE，不可篡改语义保持）。
# 未配置时清理记 error 日志（不静默），不会误删。
AUDIT_CLEANUP_DATABASE_URL=postgresql://medagent_audit_cleanup:medagent123@localhost:5432/medagent
