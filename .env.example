# ============================================
# MedAgent 数字员工系统 - 环境变量配置
# 复制此文件为 .env 并填入实际值
# ============================================

# --- 阿里云账号（团队共享）---
ALIYUN_ACCESS_KEY_ID=your_access_key_id
ALIYUN_ACCESS_KEY_SECRET=your_access_key_secret
ALIYUN_REGION=cn-hangzhou

# --- 通义千问 API（通过百炼平台调用）---
DASHSCOPE_API_KEY=your_dashscope_api_key
QWEN_MAX_MODEL=qwen-max
QWEN_PLUS_MODEL=qwen-plus
QWEN_TURBO_MODEL=qwen-turbo
QWEN_VL_MODEL=qwen-vl-max

# --- 通义听悟（语音转写）---
TINGWU_APP_KEY=your_tingwu_app_key
TINGWU_ACCESS_TOKEN=your_tingwu_access_token

# --- 阿里云百炼（多模态交互 WebSocket）---
BAILIAN_API_KEY=your_bailian_api_key
BAILIAN_WS_URL=wss://dashscope.aliyuncs.com/api-ws/v1/inference
BAILIAN_WORKSPACE_ID=your_workspace_id
BAILIAN_KB_ID=your_bailian_knowledge_base_id
BAILIAN_APP_ID=your_bailian_app_id
BAILIAN_API_BASE=https://bailian.aliyuncs.com/v2

# --- 阿里云 DashVector（向量检索）---
DASHVECTOR_API_KEY=your_dashvector_api_key
DASHVECTOR_ENDPOINT=your_dashvector_endpoint

# --- 阿里云 OSS（对象存储）---
OSS_ACCESS_KEY_ID=your_oss_access_key_id
OSS_ACCESS_KEY_SECRET=your_oss_access_key_secret
OSS_BUCKET=medagent-files
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com

# --- 数据库（本地开发用 Docker）---
DATABASE_URL=postgresql://medagent:medagent123@localhost:5432/medagent
REDIS_URL=redis://localhost:6379/0

# --- JWT 认证 ---
JWT_SECRET=change_me_to_a_random_secret_string
JWT_EXPIRES_IN=7d

# --- 服务端口 ---
SPECIALIST_SERVICE_PORT=8001
VISIT_SERVICE_PORT=8002
KNOWLEDGE_SERVICE_PORT=8003
COMPLIANCE_SERVICE_PORT=8004
AUDIT_SERVICE_PORT=8005
HCP_SERVICE_PORT=8006
GATEWAY_PORT=8000

# --- 阿里云 ARMS 监控（可选）---
ARMS_ENDPOINT=your_arms_endpoint
ARMS_APP_NAME=medagent

# --- 日志 ---
LOG_LEVEL=INFO
AUDIT_LOG_RETENTION_DAYS=1095
